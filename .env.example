# Copiá este archivo a .env y completá los valores (NUNCA subas .env a git)
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<tu-proyecto>.supabase.co/auth/v1/.well-known/jwks.json

# IA (Gemini). Conseguí la clave en https://aistudio.google.com -> Get API key.
# Sin esta clave la app funciona, pero sin las funciones automáticas de IA.
GEMINI_API_KEY=...
# Opcional: modelo a usar (por defecto gemini-3.5-flash-lite)
# AI_MODEL=gemini-3.5-flash-lite

# Google Calendar (opcional, "Opción 2"). Ver pasos en el README.
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=http://localhost:5173/calendario/google/callback

# URL pública del backend: con ella se arma el link .ics. Para que Google pueda leerlo,
# tiene que ser accesible desde internet (app publicada o túnel).
# PUBLIC_API_URL=http://localhost:8000

# Opcionales
APP_ENV=development
APP_TIMEZONE=America/Argentina/Buenos_Aires
# Lista JSON de orígenes permitidos para CORS (tu frontend)
CORS_ORIGINS=["http://localhost:5173"]
